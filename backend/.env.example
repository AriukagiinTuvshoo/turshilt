# Environment mode: development | test | production
APP_ENV=development

# Database (PostgreSQL 16 required in production)
DATABASE_URL=postgresql+psycopg://guulingiinhan:change-me@localhost:5432/guulingiinhan
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=-1
DB_CONNECT_TIMEOUT_SECONDS=10

# CORS (explicit HTTPS origins in production, comma-separated)
CORS_ORIGINS=http://localhost:3000

# Observability & Maintenance
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=1000
METRICS_ENABLED=true
# Production requires a strong Bearer token to read GET /metrics (fail-closed otherwise)
METRICS_BEARER_TOKEN=
# Optional HTTPS webhook URL invoked on HTTP 5xx spikes (never logged or returned to clients)
ALERT_WEBHOOK_URL=
ALERT_5XX_THRESHOLD=5
ALERT_COOLDOWN_SECONDS=300
PHOTO_CLEANUP_MAX_ATTEMPTS=8
TRASH_RETENTION_DAYS=30

# Private Object Storage (Cloudflare R2 or AWS S3 required in production)
# R2 endpoint format: https://<account_id>.r2.cloudflarestorage.com
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PHOTO_MAX_UPLOAD_BYTES=10485760
PHOTO_UPLOAD_USER_PER_MINUTE=20
PHOTO_UPLOAD_IP_PER_MINUTE=60
PHOTO_UPLOAD_FAMILY_PER_MINUTE=100

# Phone OTP. Generate a production value with: openssl rand -hex 32
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
# Production requires twilio with all credentials configured.
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google OpenID Connect (optional; HTTPS redirect URI + 32+ char state secret required in prod)
GOOGLE_OIDC_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_STATE_SECRET=

# Email delivery (fake for local dev/test; authenticated SMTP + STARTTLS required in production)
EMAIL_PROVIDER=fake
EMAIL_FROM=
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
