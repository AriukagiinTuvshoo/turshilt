# Root build/compose variables for docker-compose.prod.yml
# Copy to .env (or export in shell) before running `docker compose -f docker-compose.prod.yml up -d --build`
POSTGRES_DB=guulingiinhan
POSTGRES_USER=guulingiinhan
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Public API URL baked into the Next.js production bundle (never put secrets here)
NEXT_PUBLIC_API_BASE_URL=https://api.example.mn/api/v1
